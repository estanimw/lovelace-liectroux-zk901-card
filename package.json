{
    "name": "liectroux-zk901-map-card",
    "version": "0.5.2",
    "description": "Mapa, controles y editor de zonas para la integración local Liectroux ZK901 de Home Assistant",
    "keywords": [
        "home-assistant",
        "homeassistant",
        "hass",
        "automation",
        "lovelace",
        "custom-cards"
    ],
    "module": "dist/liectroux-zk901-map-card.js",
    "repository": "https://github.com/estanimw/lovelace-liectroux-zk901-card.git",
    "author": "Piotr Machowski <piotr.machowski.dev@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "change-perspective": "1.0.1",
        "custom-card-helpers": "^1.9.0",
        "home-assistant-js-websocket": "8.2.0",
        "lit": "^2.0.0",
        "pointer-tracker": "2.5.3",
        "transformation-matrix": "2.15.0"
    },
    "devDependencies": {
        "@babel/core": "^7.15.0",
        "@babel/plugin-proposal-class-properties": "^7.14.5",
        "@babel/plugin-proposal-decorators": "^7.14.5",
        "@rollup/plugin-json": "^4.1.0",
        "@typescript-eslint/eslint-plugin": "^4.33.0",
        "@typescript-eslint/parser": "^4.33.0",
        "eslint": "^7.32.0",
        "eslint-config-airbnb-base": "^14.2.1",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-import": "^2.24.0",
        "eslint-plugin-prettier": "^4.0.0",
        "playwright": "^1.62.0",
        "prettier": "^2.4.1",
        "rollup": "^2.58.0",
        "rollup-plugin-babel": "^4.4.0",
        "rollup-plugin-commonjs": "^10.1.0",
        "rollup-plugin-node-resolve": "^5.2.0",
        "rollup-plugin-serve": "^1.1.0",
        "rollup-plugin-terser": "^7.0.2",
        "rollup-plugin-typescript2": "0.35.0",
        "typescript": "^4.4.3"
    },
    "scripts": {
        "start": "rollup -c rollup.config.dev.js --watch",
        "build": "npm run lint && npm run rollup && npm run add-version",
        "add-version": "node scripts/add-version.cjs",
        "lint": "eslint src/zk901-card.ts src/zk901-controller.ts src/editor.ts src/data/zk901.ts src/model/zone-draft.ts src/model/zone-geometry.ts src/model/map-surface.ts src/types/fixes.ts",
        "rollup": "rollup -c",
        "package": "npm run build && python3 scripts/package-release.py",
        "test:browser": "node --test tests/browser/*.test.mjs"
    },
    "engines": {
        "node": "22.x"
    }
}
